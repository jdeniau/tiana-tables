{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r yarn vitest related --run --project '!storybook' --passWithNoTests",
            "timeout": 120,
            "statusMessage": "Running related tests..."
          },
          {
            "type": "command",
            "command": "yarn lint",
            "timeout": 60,
            "statusMessage": "Running lint..."
          },
          {
            "type": "command",
            "command": "yarn knip",
            "timeout": 30,
            "statusMessage": "Running knip..."
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["antd"],
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
