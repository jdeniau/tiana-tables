{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // what Node loads itself (website/vite.config.ts) imports TypeScript with its extension
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "locales",
    "website"
    // "stories" /ignore stories for now
  ]
}
